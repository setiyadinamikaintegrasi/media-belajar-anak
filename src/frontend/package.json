{
  "name": "media-belajar-anak-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && mkdir -p dist && printf 'media-belajar-anak frontend\\n' > dist/index.html",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests/unit",
    "coverage": "vitest run --coverage --coverage.thresholds.lines=80"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
